# Copy to `.env.local` (gitignored). Vite loads `VITE_*` at dev/build time.
# `vercel dev` also injects these into `/api/*` serverless handlers.

# --- Supabase (Settings → API) — required for login, projects, realtime ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only. Required by /api/get-upload-url for project ownership checks.
# Strongly recommended for Admin Data panel: full scan (orphan analytics) and all mutate actions.
# Supabase Dashboard → Settings → API → service_role (secret). Put in .env.local for vercel dev / Vite.
SUPABASE_SERVICE_ROLE_KEY=

# --- Upload API ---
# Uploads require a signed-in Supabase session; do not add client-side upload secrets.

# --- Cloudflare R2 (same bucket as production, or a dedicated dev bucket) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base for objects, e.g. https://pub-xxxxx.r2.dev (no trailing slash)
R2_PUBLIC_BASE_URL=

# --- Optional: video streaming via the media-stream Cloudflare Worker ---
# When both are set, <video> streams via HTTP Range through the Worker instead of
# downloading the whole file into a blob. Unset → app falls back to the blob
# loader. Deploy steps: workers/media-stream/README.md.
# Server-only HMAC secret — must equal the Worker's secret. NEVER prefix VITE_
# (VITE_ vars are inlined into the client bundle and visible in DevTools).
# MEDIA_STREAM_SECRET=
# Public Worker base URL (safe to expose), e.g. https://media.stage.tooawake.mov
# VITE_MEDIA_STREAM_BASE=

# --- Optional: force API origin (defaults to window.location.origin) ---
# Set to match the dev server if you use a non-default host/port.
# VITE_APP_URL=http://localhost:3000

# --- Optional: analytics cleanup cron (not needed for basic local admin/upload) ---
# CRON_SECRET=

# --- Optional: Supabase Edge Function feedback notifications ---
# These are Supabase Edge Function secrets, not Vite client variables.
# Set them in Supabase Dashboard > Edge Functions > Secrets or with `npx supabase secrets set`.
# DISCORD_FEEDBACK_WEBHOOK_URL=
# FEEDBACK_WEBHOOK_SECRET=
# ADMIN_BASE_URL=https://your-production-domain.com
